{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/.next", "!**/next-env.d.ts", "!public"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/**",
        "src/hooks/**",
        "src/lib/**",
        "src/services/**",
        "src/types/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/features/**"],
                    "message": "Shared code cannot depend on features or routes."
                  },
                  {
                    "group": ["../features/**", "../app/**", "../../**"],
                    "message": "Leave a shared folder through the @/ alias so the boundary rule applies."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/admin/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/features/**",
                      "!@/features/admin/**",
                      "!@/features/carriers/**",
                      "!@/features/sellers/**",
                      "!@/features/companies/**",
                      "!@/features/shipments/**"
                    ],
                    "message": "features/admin may import carriers, sellers, companies or shipments; compose anything else in app/."
                  },
                  {
                    "group": [
                      "../**",
                      "!../api",
                      "!../api/**",
                      "!../components/**",
                      "!../hooks/**",
                      "!../lib/**",
                      "!../types"
                    ],
                    "message": "Relative imports stay inside the feature; reach anything else through the @/ alias so the boundary rule applies."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/auth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/features/**",
                      "!@/features/auth/**"
                    ],
                    "message": "features/auth may import no other feature; compose anything else in app/."
                  },
                  {
                    "group": [
                      "../**",
                      "!../api",
                      "!../api/**",
                      "!../components/**",
                      "!../hooks/**",
                      "!../lib/**",
                      "!../types"
                    ],
                    "message": "Relative imports stay inside the feature; reach anything else through the @/ alias so the boundary rule applies."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/carriers/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/features/**",
                      "!@/features/carriers/**",
                      "!@/features/companies/**",
                      "!@/features/modalities/**"
                    ],
                    "message": "features/carriers may import companies or modalities; compose anything else in app/."
                  },
                  {
                    "group": [
                      "../**",
                      "!../api",
                      "!../api/**",
                      "!../components/**",
                      "!../hooks/**",
                      "!../lib/**",
                      "!../types"
                    ],
                    "message": "Relative imports stay inside the feature; reach anything else through the @/ alias so the boundary rule applies."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/companies/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/features/**",
                      "!@/features/companies/**"
                    ],
                    "message": "features/companies may import no other feature; compose anything else in app/."
                  },
                  {
                    "group": [
                      "../**",
                      "!../api",
                      "!../api/**",
                      "!../components/**",
                      "!../hooks/**",
                      "!../lib/**",
                      "!../types"
                    ],
                    "message": "Relative imports stay inside the feature; reach anything else through the @/ alias so the boundary rule applies."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {

                  },
                  {
                    "group": [
                      "../**",
                      "!../api",
                      "!../api/**",
                      "!../components/**",
                      "!../hooks/**",
                      "!../lib/**",
                      "!../types"
                    ],
                    "message": "Relative imports stay inside the feature; reach anything else through the @/ alias so the boundary rule applies."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/sellers/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/features/**",
                      "!@/features/sellers/**",
                      "!@/features/companies/**",
                      "!@/features/modalities/**"
                    ],
                    "message": "features/sellers may import companies or modalities; compose anything else in app/."
                  },
                  {
                    "group": [
                      "../**",
                      "!../api",
                      "!../api/**",
                      "!../components/**",
                      "!../hooks/**",
                      "!../lib/**",
                      "!../types"
                    ],
                    "message": "Relative imports stay inside the feature; reach anything else through the @/ alias so the boundary rule applies."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/shipments/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {

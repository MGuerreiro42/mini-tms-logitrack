              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/features/**",
                      "!@/features/shipments/**",
                      "!@/features/tracking/**"
                    ],
                    "message": "features/shipments may import tracking; compose anything else in app/."
                  },
                  {
                    "group": [
                      "../**",
                      "!../api",
                      "!../api/**",
                      "!../components/**",
                      "!../hooks/**",
                      "!../lib/**",
                      "!../types"
                    ],
                    "message": "Relative imports stay inside the feature; reach anything else through the @/ alias so the boundary rule applies."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/tracking/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/features/**",
                      "!@/features/tracking/**"
                    ],
                    "message": "features/tracking may import no other feature; compose anything else in app/."
                  },
                  {
                    "group": [
                      "../**",
                      "!../api",
                      "!../api/**",
                      "!../components/**",
                      "!../hooks/**",
                      "!../lib/**",
                      "!../types"
                    ],
                    "message": "Relative imports stay inside the feature; reach anything else through the @/ alias so the boundary rule applies."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}

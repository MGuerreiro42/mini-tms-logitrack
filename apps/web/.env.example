# Copy to .env.local. No secrets here — NEXT_PUBLIC_* is exposed to the browser by default.

NEXT_PUBLIC_API_URL=http://localhost:3333
# Origin for shareable tracking links; defaults to the current browser origin.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Show one-click demo account buttons on the login page; only where the API runs with SEED_DEMO=true.
NEXT_PUBLIC_DEMO_LOGIN=true

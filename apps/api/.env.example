# Copy to .env and adjust if needed. Values below already match the root docker-compose.yml.

DATABASE_URL="postgresql://tms:tms@localhost:5432/tms?schema=public"

# Next.js dev server already uses 3000 by default — API runs on a separate port
PORT=3333

# Generate a fresh value per environment, never reuse between dev/staging/prod:
#   openssl rand -hex 32
JWT_SECRET="replace-with-a-value-generated-by-openssl-rand--hex-32"

# origin allowed for CORS — Next.js runs on localhost:3000
CORS_ORIGIN="http://localhost:3000"

# Redis — same instance the root docker-compose.yml brings up, backs the
# Socket.IO adapter (@socket.io/redis-adapter) for cross-instance real-time events
REDIS_URL="redis://localhost:6379"

# Number of reverse proxies in front of the API whose X-Forwarded-For entry is trusted
# for rate limiting. 0 locally; required in production (Railway alone = 1, see README).
TRUST_PROXY=0

# Optional — only used by `pnpm test:e2e`: must name a database ending in _e2e,
# which the suite migrates and then truncates. Falls back to DATABASE_URL.
# E2E_DATABASE_URL="postgresql://tms:tms@localhost:5432/tms_e2e?schema=public"

# Optional — only used by `prisma db seed` (prisma/seed.ts). Without them, uses the defaults below.
ADMIN_EMAIL="admin@minitms.dev"
ADMIN_PASSWORD="admin12345"
# true also seeds the demo sellers, carrier and shipments (public password, keep off in production)
SEED_DEMO=true
